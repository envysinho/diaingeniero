---
import "../styles/comittee.css";
---

<section class="committee">
  <div class="committee-container">

    <h2>COMITÉ GENERAL</h2>

    <p class="committee-description">
      Comité responsable del evento
    </p>

    <div class="committee-cards">

      <div class="committee-card">
        <div class="cardc-image"></div>
        <div class="cardc-info">
          <p class="cardc-name">Ph.D. Dulio Oseda Gago</p>
          <p class="cardc-role">Coordinador de la Facultad de Ingeniería</p>
        </div>
      </div>

      <div class="committee-card">
        <div class="cardc-image"></div>
        <div class="cardc-info">
          <p class="cardc-name">Dr. Wagner Vicente Ramos</p>
          <p class="cardc-role">Responsable de la Escuela Profesional de Ingeniería de Sistemas</p>
        </div>
      </div>


      <div class="committee-card">
        <div class="cardc-image"></div>
        <div class="cardc-info">
          <p class="cardc-name">Dr. Guido Larico Uchamaco</p>
          <p class="cardc-role">Responsable del Departamento Académico de Ingeniería de Sistemas</p>
        </div>
      </div>

      <div class="committee-card">
        <div class="cardc-image"></div>
        <div class="cardc-info">
          <p class="cardc-name">Dra. Amanda Duran Carhuamaca</p>
          <p class="cardc-role">Responsable de la Unidad de Investigación de la Facultad de Ingeniería</p>
        </div>
      </div>

    </div>
  </div>
</section>